# Lapwing Environment Configuration
# Copy this file to .env and fill in your actual API keys

# LLM Provider Configuration
# Options: deepseek
LLM_PROVIDER=deepseek

# DeepSeek Configuration
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model Configuration
CHAT_MODEL=deepseek-v4-flash
SCENE_MODEL=deepseek-v4-flash

# Model Parameters
TEMPERATURE=0.95
MAX_TOKENS=4096

# Emotional State
EII_BASELINE=53

# File Paths (optional - defaults shown)
# MEMORY_FILE=json/lapwing_memory.json
# STAGING_FILE=json/staging_memory.json
# SHORT_TERM_MEMORY_FILE=json/short_term_memory.json
# STATE_FILE=json/lapwing_state.json

# Weather API (optional - uses Open-Meteo by default)
# WEATHER_API_URL=https://api-open-meteo.com/v1/forecast
# WEATHER_LATITUDE=48.8566
# WEATHER_LONGITUDE=2.3522
